generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url is now defined in prisma.config.ts
}

model User {
  id                String      @id @default(cuid())
  phoneOrEmail      String      @unique
  passwordHash      String
  name              String
  birthDate         DateTime
  gender            String
  bio               String?
  photo             String?
  preference        Preference?
  interests         String? // e.g., "Music, Travel"
  height            Int? // in cm
  relationshipGoal  String? // e.g., "Casual, Serious"
  phone             String?
  latitude          Float?
  longitude         Float?
  isVerified        Boolean     @default(false)
  verificationToken String? // random token for email verification
  verifiedAt        DateTime? // null if not verified
  resetToken        String? // for password reset
  resetTokenExpiry  DateTime? // expiry for reset token
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  statuses          Status[]
  reportsGiven      Report[]    @relation("Reporter")
  reportsReceived   Report[]    @relation("Reported")
  blocksGiven       Block[]     @relation("Blocker")
  blocksReceived    Block[]     @relation("Blocked")
 


  // --- NEW PROFILE FIELDS ---
  // Basic
  interestedIn String? // "Men", "Women", "Everyone"

  // About You
  occupation String? // "Student", "Business Owner", "Engineer", etc.
  school     String?
  education  String? // "Secondary School", "Bachelor's Degree", etc.

  // Lifestyle
  drinking String? // "Never", "Occasionally", "Socially", "Frequently"
  smoking  String? // "Non-smoker", "Social smoker", etc.
  exercise String? // "Every day", "Often", "Sometimes", "Rarely", "Never"
  pets     String? // "Dog", "Cat", "No pets", etc.

  // Personality
  communicationStyle String? // "Big texter", "Phone caller", etc.
  loveLanguage       String? // "Quality time", "Words of affirmation", etc.
  personalityType    String? // "Introvert", "Extrovert", "Ambivert"

  // Fun Questions
  idealFirstDate  String? // "Dinner", "Coffee", "Beach walk", etc.
  weekendActivity String? // "Relaxing at home", "Hanging with friends", etc.
  zodiacSign      String? // "Aries", "Taurus", etc.

  // Verification & Photos
  isEmailVerified Boolean? @default(false)
  isPhoneVerified Boolean? @default(false)
  photos          String[] // Array of photo URLs (2-6 photos)

  swipesGiven    Swipe[]    @relation("Swiper")
  swipesReceived Swipe[]    @relation("Swiped")
  matchesAsUser1 Match[]    @relation("User1")
  matchesAsUser2 Match[]    @relation("User2")
  sentMessages   Message[]
  reactions      Reaction[]

  subscription Subscription?

  // Premium System
  isPremium        Boolean   @default(false)
  premiumExpiresAt DateTime?

  // Coins
  coins Int @default(0)

  // Daily Limits
  dailyChatCount  Int @default(0)
  dailySwipeCount Int @default(0)

  // Ads Rewards
  rewardedChats  Int @default(0)
  rewardedSwipes Int @default(0)
}

model Status {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl  String // Cloudinary URL
  createdAt DateTime @default(now())
  expiresAt DateTime // createdAt + 24 hours

  @@index([userId])
  @@index([expiresAt])
}


model Match {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  status    String   @default("ACTIVE")
  matchedAt DateTime @default(now())

  user1 User @relation("User1", fields: [user1Id], references: [id])
  user2 User @relation("User2", fields: [user2Id], references: [id])

  messages Message[]
}

model Message {
  id        String     @id @default(cuid())
  matchId   String
  senderId  String
  content   String?
  imageUrl  String?
  audioUrl  String?
  isRead    Boolean    @default(false)
  sentAt    DateTime   @default(now())
  replyToId String?    @map("reply_to_id")
  replyTo   Message?   @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   Message[]  @relation("MessageReplies")
  reactions Reaction[]

  match  Match @relation(fields: [matchId], references: [id])
  sender User  @relation(fields: [senderId], references: [id])
}

model Swipe {
  id        String   @id @default(cuid())

  swiperId  String
  swipedId  String

  // LIKE, PASS, SUPERLIKE
  direction String

  createdAt DateTime @default(now())

  swiper User @relation("Swiper", fields: [swiperId], references: [id], onDelete: Cascade)
  swiped User @relation("Swiped", fields: [swipedId], references: [id], onDelete: Cascade)

  @@unique([swiperId, swipedId])
  @@index([swiperId])
  @@index([swipedId])
  @@index([direction])
}

model Preference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minAge          Int      @default(18)
  maxAge          Int      @default(99)
  maxDistance     Int      @default(100)
  preferredGender String? // "Male", "Female", "All"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  reportedId  String
  reason      String // e.g., "Spam", "Harassment", "Fake Profile", "Inappropriate Content", "Other"
  description String? // optional user description
  status      String   @default("PENDING") // "PENDING", "RESOLVED", "DISMISSED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter User @relation("Reporter", fields: [reporterId], references: [id])
  reported User @relation("Reported", fields: [reportedId], references: [id])

  @@index([reporterId])
  @@index([reportedId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   String
  amount Float

  startsAt  DateTime @default(now())
  expiresAt DateTime

  status String @default("ACTIVE")

  createdAt DateTime @default(now())
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String // e.g. "❤️", "😂", "😮", "😢", "👍"
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
}
